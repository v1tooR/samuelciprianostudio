# Only the two public endpoints answer; helpers, config and saved data never do.
<FilesMatch "^(_lib|config|config\.example)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
RedirectMatch 404 ^/api/dados(/|$)
Options -Indexes
